# Google Agent Development Kit (ADK) Environment Configuration Template

# 1. Google AI Studio (Gemini API)
# Get your API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your-gemini-api-key"

# 2. Alternatively, Google Cloud Vertex AI
# Uncomment the following lines if running on Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI="TRUE"
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# GOOGLE_CLOUD_LOCATION="us-central1"

# 3. Optional MCP & Tool Integrations
# MCP_AUTH_TOKEN="your-mcp-bearer-token"
# REMOTE_MCP_URL="https://your-mcp-server.example.com/sse"
# GOOGLE_MAPS_API_KEY=""

# 4. Observability & Tracing (optional)
# ADK_LOG_LEVEL="INFO"

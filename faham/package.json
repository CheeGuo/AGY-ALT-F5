{
  "name": "faham",
  "private": true,
  "version": "0.1.0",
  "description": "FAHAM: BM-English STEM learning with offline packs, local progress and reliable sync",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/server.mjs --dev\" \"vite\"",
    "build": "node scripts/build-pack.mjs && tsc -b && vite build",
    "start": "node server/server.mjs",
    "pack": "node scripts/build-pack.mjs",
    "test": "vitest run && node --test server/",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
